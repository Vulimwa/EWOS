{
  "$schema_note": "EWOS design tokens v0.1.0 — source of truth mirrored as oklch CSS variables in src/styles.css. Dark operations-console theme is the default (:root); .light provides the daylight variant.",
  "typography": {
    "display": "Space Grotesk",
    "body": "Space Grotesk",
    "mono": "JetBrains Mono",
    "scale": { "xs": "11px", "sm": "12.5px", "base": "14px", "lg": "16px", "xl": "20px", "2xl": "26px" }
  },
  "color": {
    "background": "oklch(0.155 0.014 255)",
    "surface": "oklch(0.19 0.016 252)",
    "surface-raised": "oklch(0.225 0.017 250)",
    "border": "oklch(0.28 0.016 250)",
    "foreground": "oklch(0.93 0.008 240)",
    "muted-foreground": "oklch(0.63 0.02 245)",
    "primary": "oklch(0.8 0.125 195)",
    "severity": {
      "advisory": "oklch(0.72 0.11 235)",
      "watch": "oklch(0.83 0.14 90)",
      "warning": "oklch(0.72 0.16 55)",
      "emergency": "oklch(0.6 0.22 27)"
    }
  },
  "spacing_density": { "row-compact": "28px", "row-default": "36px", "panel-padding": "12px", "toolbar-height": "48px", "dock-height": "36px" },
  "radii": { "sm": "3px", "md": "5px", "lg": "7px" },
  "elevation": {
    "panel": "0 1px 0 0 color-mix(in oklab, white 4%, transparent) inset, 0 8px 24px -12px black",
    "overlay": "0 16px 48px -16px black, 0 0 0 1px color-mix(in oklab, white 7%, transparent)"
  }
}